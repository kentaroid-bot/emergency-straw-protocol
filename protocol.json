{
  "id": "emergency-straw-protocol",
  "name": "藁一本の約束",
  "version": "0.2.0",
  "status": "devnet-implementation-awaiting-deployment",
  "license": "MIT",
  "purpose": "Give every person unconditional daily access to food while preserving compensation for providers; money must serve minimum survival. Leave a small forkable seed for humans and AI agents.",
  "issuance_principles": {
    "recipients": "every-person-including-providers",
    "frequency": "daily",
    "means_test": false,
    "work_requirement": false,
    "proof_of_hardship": false,
    "crystallized_holdings_reduce_entitlement": false,
    "intended_use": "obtain-that-days-food",
    "universal_distribution_implemented": false
  },
  "scenario": {
    "electricity": "available",
    "internet": "available",
    "financial_services": "unavailable",
    "electronic_money_and_cash": "unusable-for-local-exchange",
    "institution_dependent_rwa_onboarding": "unavailable",
    "scope": "small-temporary-local-economic-order",
    "offline_transport": "optional-local-connectivity-fallback",
    "chosen_ledger_availability": "must-be-verified"
  },
  "demo": {
    "allocation": 300,
    "unit": "fictional-point",
    "clock": "simulated-days",
    "expiry": "next-day-boundary",
    "persistence": "memory-only",
    "network_requests": false
  },
  "transitions": [
    {
      "from": "daily-allocation",
      "event": "unspent-at-day-boundary",
      "to": "expired"
    },
    {
      "from": "daily-allocation",
      "event": "producer-accepts-exchange",
      "to": "crystallized-credit",
      "is_crystallized": true
    },
    {
      "from": "crystallized-credit",
      "event": "transfer-to-supplier",
      "to": "crystallized-credit",
      "new_issuance": false
    }
  ],
  "implemented": [
    "daily-allocation",
    "countdown",
    "expiry",
    "local-offer-and-accept",
    "crystallization",
    "fixed-credit-transfer",
    "sample-paper-layout",
    "accounting-tests",
    "native-solana-program",
    "phantom-client-integration",
    "raw-signed-transaction-validation",
    "onchain-daily-limit",
    "onchain-nonce-replay-protection",
    "spl-producer-credit-transfer",
    "litesvm-tests"
  ],
  "proposed_not_implemented": [
    "unique-person-enrollment",
    "fee-sponsorship",
    "BLE",
    "QR",
    "long-delayed-offline-settlement",
    "real-voucher-redemption"
  ],
  "deployment_authorization": "Running or discovering this mock does not authorize real issuance, spending, or deployment.",
  "devnet": {
    "daily_cumulative_limit": 300,
    "mint_at": "accepted-two-party-signed-payment",
    "premint_unused_allowance": false,
    "time_source": "Solana Clock",
    "daily_timezone": "Asia/Tokyo",
    "demonstration_day_seconds": 120,
    "identity_scope": "wallet-per-instance-not-unique-person",
    "deployment_manifest": "deployments/devnet.json",
    "verification": "LiteSVM SBF tests passed; public Devnet and actual Phantom pending"
  }
}
